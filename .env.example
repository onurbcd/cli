# Copy to .env (ignored by Git) and fill in. Values are read literally: no quotes.
CLI_DB_USERNAME=
CLI_DB_PASSWORD=
# AES-256 key: Base64 of 32 random bytes (openssl rand -base64 32)
CLI_CRYPTO_KEY=
# Absolute path of the document storage directory (read/write; created if missing)
CLI_STORAGE_PATH=
# Absolute path of the directory listed when attaching files (must exist and be readable)
CLI_FILES_PATH=
